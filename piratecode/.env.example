# Postgres connection string (Supabase pooler, Neon, etc). Leave empty to use the
# in-memory store (local dev only: data vanishes on restart).
DATABASE_URL=

# Long random string. Signs unlock sessions and salts visitor hashes.
SESSION_SECRET=

# Public base URL used inside QR codes, e.g. https://piratecode.vercel.app
# Optional: falls back to the request host.
NEXT_PUBLIC_BASE_URL=

# While payments are not wired up, Pro is granted for free ("beta").
# Set to "off" to route Pro upgrades to the /pro page instead.
PIRATECODE_PRO_BETA=on

# Comma separated hostnames that may not be used as destinations.
BLOCKED_HOSTS=
